// Concept map: {{NAME}}
// Convention v1: kind=activity|process|outcome, main=true, rel=is_a, subgraph cluster_<id>.
// Frozen layout: every position below is stored. Change positions only through a
// layout edit session or an approved agent change. Created by the zettelkasten skill, {{DATE}}.
digraph Map {
    layout=neato  frozen=true  convention=1
    node [fontname=Helvetica fontsize=12 margin="0.15,0.08" shape=box style=rounded]
    edge [fontname=Helvetica fontsize=10]

    topic [label="{{LABEL}}" main=true pos="0,0!" width={{WIDTH}} height=0.500 fixedsize=true]
}
